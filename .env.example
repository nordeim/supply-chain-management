# Supply Chain Management — environment contract
# Copy to .env and adjust. Only DATABASE_URL is required; everything else
# has a safe default (validated at boot by src/lib/env.ts).

# ---- Database -------------------------------------------------------------
# SQLite by default (zero-config local dev). The `db/` folder lives at the
# repo root, git-ignored. A RELATIVE `file:` URL is anchored at the
# prisma/ schema directory — so `file:../db/custom.db` points at
# <repo>/db/custom.db — regardless of the process working directory.
# src/lib/db-path.ts implements this resolution for the running server,
# the seed, and the analytics verifier; the `bun run db:*` scripts route
# the Prisma CLI through scripts/db-cli.ts so the CLI sees the same
# absolute URL. (src/lib/db-path.test.ts pins the contract.)
# Note: an exported DATABASE_URL in your shell wins over this file —
# export an absolute URL only if you intend to override the location.
# For production, an ABSOLUTE path is still recommended — see
# docs/DEPLOYMENT.md §4.
# To use PostgreSQL:
#   1. Set provider = "postgresql" in prisma/schema.prisma
#   2. Set DATABASE_URL to a PostgreSQL connection string
#   3. bun run db:push && bun run db:seed
DATABASE_URL="file:../db/custom.db"
# PostgreSQL example:
# DATABASE_URL=postgresql://user:password@localhost:5432/designer_portfolio

# ── Sessions (required in production) ──────────────────────────────────
# Secret used to HMAC-sign the session cookie. Generate with:
#   openssl rand -base64 32
# The dev default is an insecure placeholder; production session signing
# refuses it at runtime (src/lib/env.ts getServerEnv). Leave empty for dev.
SESSION_SECRET=""

# ── Seed demo account (optional) ───────────────────────────────────────
# Credentials provisioned by `bun run db:seed` for the sign-in demo.
# Also read by e2e/auth.spec.ts (Playwright) to drive the sign-in flow.
# Defaults: demo@supplychain.local / demo-password
# SEED_DEMO_EMAIL="you@example.com"
# SEED_DEMO_PASSWORD="use-a-strong-password"

# ── Playwright E2E (optional) ──────────────────────────────────────────
# `bun run test:e2e` boots `next start` on its own port; override only in CI
# or when 3002 is taken. Set E2E_BASE_URL to reuse an already-running
# server instead of starting one.
# E2E_PORT=3002
# E2E_BASE_URL="http://127.0.0.1:3002"
