# Supply Chain Management — environment contract
# Copy to .env and adjust. Only DATABASE_URL is required; everything else
# has a safe default (validated at boot by src/lib/env.ts).

# ── Database (required) ────────────────────────────────────────────────
# SQLite via Prisma. Relative `file:` paths resolve against prisma/schema.prisma,
# so "file:../db/custom.db" stores the database at <repo>/db/custom.db.
# Production note: to move to PostgreSQL, change the datasource provider in
# prisma/schema.prisma and set e.g.
#   DATABASE_URL="postgresql://user:password@localhost:5432/supply_chain"
DATABASE_URL="file:../db/custom.db"

# ── Sessions (required in production) ──────────────────────────────────
# Secret used to HMAC-sign the session cookie. Generate with:
#   openssl rand -base64 32
# The dev default is an insecure placeholder; production boot refuses it.
SESSION_SECRET=""

# ── Seed demo account (optional) ───────────────────────────────────────
# Credentials provisioned by `bun run db:seed` for the sign-in demo.
# Defaults: demo@supplychain.local / demo-password
# SEED_DEMO_EMAIL="you@example.com"
# SEED_DEMO_PASSWORD="use-a-strong-password"
